# Dori — Environment Variables
#
# Copy this file to `.env` and fill in the values before running the
# appliance with `docker compose up`. For local development the committed
# `.env.development` / `.env.test` files are loaded automatically by
# dotenvx via the npm scripts.

# ─── Runtime ────────────────────────────────────────────────────────────
NODE_ENV="production"

# ─── Application (public URL) ───────────────────────────────────────────
# Either set DORI_APPLICATION_URL directly, or the parts below.
DORI_APPLICATION_SCHEME="http"
DORI_APPLICATION_HOST="localhost"
DORI_APPLICATION_PORT="3000"
# DORI_APPLICATION_URL="https://crm.example.com"

# ─── better-auth ────────────────────────────────────────────────────────
# Generate a strong secret, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
BETTER_AUTH_URL="http://localhost:3000"
# Optional table/key prefixes for the auth tables (defaults shown)
# BETTER_AUTH_TABLE_PREFIX="betterauth_"
# BETTER_AUTH_KEY_PREFIX="better-auth:"

# ─── PostgreSQL ─────────────────────────────────────────────────────────
DORI_POSTGRESQL_SCHEME="postgresql"
DORI_POSTGRESQL_HOST="localhost"
DORI_POSTGRESQL_PORT="5432"
DORI_POSTGRESQL_USERNAME="dori"
DORI_POSTGRESQL_PASSWORD="CHANGE_ME_postgres_password"
DORI_POSTGRESQL_NAME="dori"

# ─── Redis ──────────────────────────────────────────────────────────────
DORI_REDIS_SCHEME="redis"
DORI_REDIS_HOST="localhost"
DORI_REDIS_PORT="6379"
DORI_REDIS_USERNAME="default"
DORI_REDIS_PASSWORD="CHANGE_ME_redis_password"

# ─── Table / Key prefixes (optional) ────────────────────────────────────
# DORI_TABLE_PREFIX="dori_"
# DORI_KEY_PREFIX="dori:"

# ─── Seeding (optional, used by the docker `migrate` step) ───────────────
# Set to "true" to plant demo data on first migrate.
DORI_SEED="false"

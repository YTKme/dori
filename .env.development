NODE_ENV="development"

# Application
DORI_APPLICATION_SCHEME="http"
DORI_APPLICATION_HOST="localhost"
DORI_APPLICATION_PORT="3000"

# better-auth (development only — never reuse this secret in production)
BETTER_AUTH_SECRET="dev_only_better_auth_secret_change_in_production_0123456789"
BETTER_AUTH_URL="http://localhost:3000"

# PostgreSQL (served by docker-compose.dev.yml, exposed on localhost)
DORI_POSTGRESQL_SCHEME="postgresql"
DORI_POSTGRESQL_HOST="localhost"
DORI_POSTGRESQL_PORT="5432"
DORI_POSTGRESQL_USERNAME="dori"
DORI_POSTGRESQL_PASSWORD="dori"
DORI_POSTGRESQL_NAME="dori"

# Redis (local Redis, no auth by default)
DORI_REDIS_SCHEME="redis"
DORI_REDIS_HOST="localhost"
DORI_REDIS_PORT="6379"
DORI_REDIS_USERNAME="default"
DORI_REDIS_PASSWORD=""
